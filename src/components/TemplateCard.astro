---
import { Image } from 'astro:assets';
import type { Template } from '../data/templates';

interface Props {
  template: Template;
  /** eager-load image (above the fold) */
  eager?: boolean;
}

const { template: t, eager = false } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/workflows/*.{PNG,png}'
);
const imageEntry = t.image ? images[`../assets/workflows/${t.image}`] : null;
const img = imageEntry ? (await imageEntry()).default : null;
---
<article class="card template-card">
  {img && (
    <a href={`/templates/${t.slug}`} class="card-img" tabindex="-1" aria-hidden="true">
      <Image src={img} alt={t.imageAlt} widths={[480, 760]} sizes="(max-width: 900px) 100vw, 360px" loading={eager ? 'eager' : 'lazy'} />
    </a>
  )}
  <h3><a href={`/templates/${t.slug}`}>{t.name}</a></h3>
  <p class="mechanism">{t.mechanism}</p>
  {t.provenance && <p class="provenance">{t.provenance}</p>}
  <ul class="integrations" aria-label="Integrations">
    {t.integrations.map((i) => <li>{i}</li>)}
  </ul>
  <div class="card-foot">
    <span class="price">{t.price === null ? 'Free' : `$${t.price}`}</span>
    <a href={`/templates/${t.slug}`} class="btn btn-secondary btn-sm">
      {t.price === null ? 'Get it free' : 'View template'}
    </a>
  </div>
</article>

<style>
  .template-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 0 24px;
    overflow: hidden;
  }
  .card-img {
    display: block;
    border-bottom: 1px solid var(--c-border);
    background: #0d0d0d;
  }
  .card-img img {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: cover;
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }
  .template-card:hover .card-img img { opacity: 1; }
  .template-card h3 { margin: 6px 24px 0; font-size: 1.15rem; }
  .template-card h3 a { text-decoration: none; }
  .mechanism { margin: 0 24px; color: var(--c-text-body); font-size: 0.95rem; }
  .provenance {
    margin: 0 24px;
    color: var(--c-text-mute);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }
  .integrations {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 24px;
    padding: 0;
  }
  .integrations li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--c-text-dim);
    border: 1px solid var(--c-border);
    border-radius: 4px;
    padding: 2px 8px;
  }
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: auto 24px 0;
    padding-top: 14px;
  }
  .btn-sm { padding: 8px 16px; font-size: 0.85rem; }
</style>
