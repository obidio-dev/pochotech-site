---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { CALENDLY, EMAIL } from '../data/site';
import { graph, faqSchema, reviewSchema } from '../lib/schema';

const FREE_TEMPLATE = 'https://checkout.lemonsqueezy.com/buy/1320841';

const metrics = [
  { value: '1.5–2 hrs → 15 min', label: 'Proposal processing, event production agency' },
  { value: '5 hrs/week → 1.5 hrs', label: 'Creator tracking, travel media company' },
  { value: '30 → 70', label: 'Creators tracked, same workflow, same team' },
  { value: '400+ articles/day', label: 'Curated into one newsletter with zero human input' },
];

const faqs = [
  {
    q: 'What a custom automation costs',
    a: 'Builds start at $1,500, with a fixed price set in writing after the discovery call. What it costs depends on how many systems are involved and how much of the logic needs AI. If you start with the $500 audit, that full amount is credited toward the build.',
  },
  {
    q: 'How long a build takes',
    a: 'One to four weeks for most projects, depending on how many systems are involved and how much testing the workflow needs against your real data. The timeline is written into the scope document before any work begins, so you know the delivery date before you commit.',
  },
  {
    q: 'Who does the actual work',
    a: 'I do: every workflow, every integration, every fix. pocho.tech is one engineer, and you work with me directly from the first call through handoff.',
  },
  {
    q: 'Who owns the workflows',
    a: 'You do. Everything runs in your accounts under your credentials, on your n8n or Make.com instance, with your API keys. If we ever part ways, every workflow keeps running exactly as it did the day before; nothing I build depends on infrastructure that belongs to me.',
  },
  {
    q: 'What happens after handoff',
    a: 'Most clients keep me on. All three teams on this page started with a single build and continue on embedded retainers, scoped per engagement.',
  },
  {
    q: 'Why n8n and Make.com instead of Zapier',
    a: 'Zapier is fine for simple triggers, but the systems I build (AI evaluation pipelines, multi-step branching logic, two-way syncs) need real conditionals, sub-workflows, and direct API calls. n8n and Make.com handle that at a fraction of the per-task cost, and n8n can run on your own server.',
  },
  {
    q: 'What the $500 audit includes',
    a: 'A 60-minute review of how your team actually works, then a written report within five business days: what to automate first, which tools to use, estimated time savings, and the build scope for each recommendation. Commission a build afterward and the full $500 comes off the price.',
  },
  {
    q: 'Whether templates require technical skill',
    a: 'Each template includes the n8n workflow JSON, a step-by-step PDF setup guide, and a walkthrough video. If you can follow instructions and paste API credentials, you can install one. If you would rather not, Done-For-You Setup adds $100 and I configure it with you on a live call.',
  },
];

const kyreneQuote =
  'Erick was incredibly helpful in setting up the system to automatically track creator content. This automation saves me roughly 3-4 hours per week, and has made my workflow much smoother and saves a lot of manual effort.';

const jsonLd = graph(
  faqSchema(faqs),
  reviewSchema({
    body: kyreneQuote,
    authorName: 'Social media team member',
    authorTitle: 'Travel media company',
  })
);
---
<Base
  title="Custom AI Automation for Small Teams | pocho.tech"
  description="I help small teams create proposals, reports, and client updates in minutes instead of hours. Twelve automations in production. Builds from $1,500."
  path="/"
  jsonLd={jsonLd}
>
  <!-- 1. Hero -->
  <section class="hero">
    <div class="wrap">
      <h1>I help small teams create proposals in fifteen minutes instead of two hours.</h1>
      <p class="hero-sub">
        That is a real number: the proposal-to-invoice pipeline I run for an event production agency, one of
        twelve automations in production across three client teams. I’m Erick Bonilla, and you work directly
        with the engineer who builds it.
      </p>
      <div class="hero-ctas">
        <a href={CALENDLY} class="btn btn-primary" rel="noopener">Book a discovery call</a>
        <a href={FREE_TEMPLATE} class="btn btn-secondary" rel="noopener">Get the free template</a>
      </div>
    </div>
  </section>

  <!-- 2. Proof strip -->
  <section class="proof" aria-label="Production metrics">
    <div class="wrap">
      <p class="eyebrow">Three teams. Twelve automations. Real numbers.</p>
      <dl class="proof-grid">
        {metrics.map((m) => (
          <div class="proof-item">
            <dt class="metric">{m.value}</dt>
            <dd>{m.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 3. Case-study previews -->
  <section class="section" aria-labelledby="work-h">
    <div class="wrap">
      <h2 id="work-h">The work, with numbers attached.</h2>
      <div class="grid-3 case-grid">
        <article class="card case-card">
          <p class="metric metric-card">2–4 proposals a day, 15 minutes each.</p>
          <p class="case-client">Event production agency, team of six to eight.</p>
          <p>
            An accepted proposal in Fresh Proposals updates the HubSpot deal stage, builds the Monday.com board,
            and creates the QuickBooks customer with two 50/50 invoices, untouched. At 2–4 proposals a day,
            that’s 6–8 hours of manual operations gone from every working day.
          </p>
          <a href="/case-studies/event-production-agency" class="case-link">Read the case study</a>
        </article>
        <article class="card case-card">
          <p class="metric metric-card">400+ articles a day. Ten make the newsletter.</p>
          <p class="case-client">Travel media company, editorial team of twelve.</p>
          <p>
            Overnight, an AI reads eleven-plus publications, picks the ten stories that matter, and delivers a
            finished newsletter every morning. Their creator tracker went from 5 hours a week to 1.5, covering
            70 creators instead of 30.
          </p>
          <a href="/case-studies/travel-media-company" class="case-link">Read the case study</a>
        </article>
        <article class="card case-card">
          <p class="metric metric-card">From zero operational visibility to automated daily reporting.</p>
          <p class="case-client">EdTech workforce training, Boston. 30–40 applicants per cohort.</p>
          <p>
            Six connected systems run their admissions and operations: AI-scored interviews from Read.ai
            transcripts, scheduling, stipend-eligibility alerts, and the 5pm report the whole team reads.
          </p>
          <blockquote class="card-quote">
            <p>“You have done such a great job that I can’t remember how we were working before you.”</p>
            <cite>CEO, EdTech workforce-training company</cite>
          </blockquote>
          <a href="/case-studies/edtech-workforce-training" class="case-link">Read the case study</a>
        </article>
      </div>
      <blockquote class="support-quote">
        <p>
          “Erick has helped us build and implement multiple automations for our editorial department, and these
          save us time each week that can be spent producing content rather than sifting through emails and data.”
        </p>
        <cite>Editorial team, travel media company</cite>
      </blockquote>
    </div>
  </section>

  <!-- 4. Founder -->
  <section class="section section-alt" aria-labelledby="founder-h">
    <div class="wrap founder">
      <h2 id="founder-h">Who builds this</h2>
      <p>
        I’m Erick Bonilla, founder and the only engineer at pocho.tech. Every automation on this page, I scoped
        and built myself, and most of them I still operate.
      </p>
      <p>I work embedded: in your Slack, inside your accounts, as a team member whose job is automation.</p>
      <p>
        I build on n8n and Make.com with the OpenAI and Anthropic APIs, and I speak about this work at industry
        conferences.
      </p>
      <p>The travel media company on this page hired me to build after I taught n8n to their AI lead.</p>
      <p class="founder-close">When something breaks, you message the person who wrote it.</p>
      <a href="/about" class="case-link">More about how I work</a>
    </div>
  </section>

  <!-- 5. Services -->
  <section class="section" aria-labelledby="services-h">
    <div class="wrap">
      <h2 id="services-h">Three ways to start.</h2>
      <div class="grid-3">
        <article class="card service-card">
          <h3>Automation Audit</h3>
          <p class="price">$500, credited in full toward a custom build</p>
          <p>
            A 60-minute review of how your team actually works, then a written report within five business days.
            You get what to automate first, which tools, estimated time savings, and the build scope for each
            recommendation.
          </p>
          <p>Commission a build afterward and the $500 comes off the price.</p>
          <a href={CALENDLY} class="btn btn-secondary" rel="noopener">Book an audit</a>
        </article>
        <article class="card service-card service-flagship">
          <h3>Custom Automation Build</h3>
          <p class="price">From $1,500, fixed price after a discovery call</p>
          <p>
            I design the solution, build and test it on your systems, and hand it off with documentation and a
            walkthrough. Typical timeline is one to four weeks.
          </p>
          <p>This is how every case study on this page started.</p>
          <a href={CALENDLY} class="btn btn-primary" rel="noopener">Book a discovery call</a>
        </article>
        <article class="card service-card">
          <h3>Done-For-You Setup</h3>
          <p class="price">Template price + $100</p>
          <p>
            A live 60–90 minute session: I connect your credentials, configure the workflow, and test it with you
            on the call. You keep a recording of the whole session.
          </p>
          <a href="/templates" class="btn btn-secondary">Browse templates</a>
        </article>
      </div>
      <p class="service-note">
        Most engagements don’t end at handoff. All three client teams on this page continue on embedded
        retainers, scoped per engagement on the discovery call.
      </p>
      <p class="service-note service-note-small">
        I also consult on n8n and Make.com: training and architecture review for teams that want to build
        in-house. <a href="/services/n8n-consulting">n8n &amp; Make.com consulting</a>
      </p>
    </div>
  </section>

  <!-- 6. How an engagement works -->
  <section class="section section-alt" aria-labelledby="process-h">
    <div class="wrap">
      <h2 id="process-h">How an engagement works</h2>
      <ol class="process">
        <li>
          <h3>Discovery call <span class="step-time">60 minutes</span></h3>
          <p>You walk me through how the work actually happens, and I look for where the hours go. Book it directly on my calendar.</p>
        </li>
        <li>
          <h3>Solution design <span class="step-time">a few days</span></h3>
          <p>You get a written scope: what I’ll build, what it connects to, the fixed price, and the timeline. Nothing starts until you approve it.</p>
        </li>
        <li>
          <h3>Build and test <span class="step-time">one to four weeks</span></h3>
          <p>I build on your systems and test against your real data, checking in as each piece goes live.</p>
        </li>
        <li>
          <h3>Handoff <span class="step-time">one call</span></h3>
          <p>You get documentation and a recorded walkthrough of everything I built.</p>
        </li>
      </ol>
      <div class="process-notes">
        <p>
          <strong>You own all of it.</strong> The workflows run in your accounts under your credentials. If we
          ever part ways, everything keeps running.
        </p>
        <p>
          <strong>What “embedded” means:</strong> most clients keep me on after handoff, working inside their
          Slack, their CRM, their boards, as a team member who happens to be an automation engineer. That’s how
          one automation at the events agency became four, and one system at the EdTech company became six.
        </p>
      </div>
    </div>
  </section>

  <!-- 7. Industries -->
  <section class="section" aria-labelledby="industries-h">
    <div class="wrap">
      <h2 id="industries-h">Where I work</h2>
      <div class="grid-2 industry-grid">
        <a class="card industry-card" href="/industries/media-publishing">
          <h3>Media &amp; publishing</h3>
          <p>
            Four automations run a travel media company’s editorial back office: newsletter curation from 400+
            daily articles, a 70-creator tracker, affiliate reporting, and event search across 15 cities.
          </p>
        </a>
        <a class="card industry-card" href="/industries/marketing-agencies">
          <h3>Agencies</h3>
          <p>
            An event production agency runs four: web lead routing, AI referral capture, the proposal-to-invoice
            pipeline, and a business card scanner that lives in Slack.
          </p>
        </a>
        <a class="card industry-card" href="/industries/destination-marketing">
          <h3>Destination marketing organizations</h3>
          <p>
            For tourism boards and convention bureaus: partner tracking, AI email agents, content pipelines, and
            lead qualification. I come from the travel-media side of this industry and speak at its conferences.
          </p>
        </a>
        <a class="card industry-card" href="/industries/accounting-firms">
          <h3>Accounting &amp; CPA firms</h3>
          <p>
            Bookkeeping and tax workflow automation: QuickBooks Online, TaxDome, and the client communications
            that surround every deadline.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- 8. Templates teaser -->
  <section class="section section-alt" aria-labelledby="templates-h">
    <div class="wrap">
      <h2 id="templates-h">Seven workflows, extracted from real client systems.</h2>
      <p class="templates-sub">
        Each one is the n8n workflow JSON, a step-by-step PDF setup guide, and a 90-second walkthrough video. Add
        Done-For-You Setup for $100 and I install it with you on a live call.
      </p>
      <div class="grid-3">
        <article class="card teaser-card">
          <h3><a href="/templates/business-card-scanner">Business Card Scanner</a></h3>
          <p>
            Drop a photo in Slack; an AI reads the card, extracts every field, and creates the CRM contact.
            Running in production at an event production agency.
          </p>
          <p class="teaser-tools">Slack · OpenAI GPT-4o Vision · HubSpot</p>
          <a href="https://checkout.lemonsqueezy.com/buy/1320724" class="btn btn-secondary" rel="noopener">Get the scanner: $249</a>
        </article>
        <article class="card teaser-card">
          <h3><a href="/templates/ai-newsletter-curator">AI Newsletter Curator</a></h3>
          <p>
            An AI that scrapes your chosen industry sources overnight, picks the most newsworthy stories, writes
            summaries, and delivers a finished newsletter every morning. The production version at a travel
            media company processes 400+ articles a day.
          </p>
          <p class="teaser-tools">Google Sheets · Apify · OpenAI · Gmail</p>
          <a href="https://checkout.lemonsqueezy.com/buy/1320787" class="btn btn-secondary" rel="noopener">Get the curator: $249</a>
        </article>
        <article class="card teaser-card">
          <h3><a href="/templates/jarvis-ai-executive-assistant">Jarvis: AI Executive Assistant</a></h3>
          <p>
            An AI assistant living inside Slack that reads your email, manages your calendar, and tracks your
            tasks on plain-English instructions. The most involved template in the catalog: main workflow,
            sub-workflow, and system prompt reference included.
          </p>
          <p class="teaser-tools">Slack · Gmail · Google Calendar · Anthropic Claude · PostgreSQL</p>
          <a href="https://checkout.lemonsqueezy.com/buy/1320707" class="btn btn-secondary" rel="noopener">Get Jarvis: $399</a>
        </article>
      </div>
      <div class="lead-magnet">
        <div>
          <h3>Sheets ↔ HubSpot Task Manager: <span class="free">Free</span></h3>
          <p>
            A live two-way sync between a Google Sheet and HubSpot tasks: create, update, and complete in
            either; both stay current. Start here if you want to see how I build before spending anything.
          </p>
        </div>
        <a href={FREE_TEMPLATE} class="btn btn-primary" rel="noopener">Get it free</a>
      </div>
      <p class="templates-all"><a href="/templates">Browse all seven templates</a></p>
    </div>
  </section>

  <!-- 9. Testimonial -->
  <section class="section" aria-label="Client testimonial">
    <div class="wrap">
      <blockquote class="big-quote">
        <p>“{kyreneQuote}”</p>
        <cite>Social media team, travel media company</cite>
      </blockquote>
      <p class="quote-context">
        On the creator tracker, one of four automations running at the travel media company. When it goes down, the team
        emails within hours asking for it back.
      </p>
    </div>
  </section>

  <!-- 10. FAQ -->
  <Faq faqs={faqs} heading="Questions I get on every discovery call" />

  <!-- 11. Final CTA -->
  <section class="section section-alt final-cta">
    <div class="wrap">
      <h2>Tell me where the hours go.</h2>
      <p>
        Sixty minutes: you walk me through how your team works, and I tell you what I’d automate first and what
        it would cost.
      </p>
      <p>
        If the right answer is a $249 template instead of a custom build, I’ll say so. If it’s not a fit, you’ll
        hear that on the call.
      </p>
      <div class="hero-ctas">
        <a href={CALENDLY} class="btn btn-primary" rel="noopener">Book a discovery call</a>
      </div>
      <p class="cta-alt">
        Or write to me directly: <a href={`mailto:${EMAIL}`}>{EMAIL}</a><br />
        Or start with the <a href={FREE_TEMPLATE} rel="noopener">free Sheets ↔ HubSpot sync</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(72px, 12vw, 130px) 0 56px; }
  .hero h1 { max-width: 21ch; }
  .hero-sub { font-size: 1.12rem; color: var(--c-text-body); max-width: 58ch; margin-top: 20px; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 32px; }

  .proof { padding: 48px 0; border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border); background: var(--c-surface-alt); }
  .proof-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; margin: 18px 0 0; }
  .proof-item dd { margin: 6px 0 0; color: var(--c-text-dim); font-size: 0.85rem; }
  .metric { font-family: var(--font-mono); color: var(--c-red); font-weight: 700; font-size: clamp(1.15rem, 2.2vw, 1.5rem); margin: 0; }

  .case-grid { margin-top: 36px; }
  .case-card { display: flex; flex-direction: column; gap: 12px; }
  .case-card p { margin: 0; font-size: 0.95rem; }
  .metric-card { font-size: 1.25rem; line-height: 1.3; }
  .case-client { color: var(--c-text-dim); font-size: 0.88rem !important; }
  .case-link { margin-top: auto; color: var(--c-text); font-size: 0.92rem; }
  .card-quote { margin: 4px 0 0; border-left: 2px solid var(--c-border); padding-left: 14px; }
  .card-quote p { font-style: italic; color: var(--c-text-body); }
  .card-quote cite, .support-quote cite, .big-quote cite { display: block; margin-top: 8px; color: var(--c-text-dim); font-style: normal; font-size: 0.85rem; }
  .support-quote { margin: 48px auto 0; max-width: 720px; border-left: 2px solid var(--c-border); padding-left: 20px; }
  .support-quote p { font-style: italic; color: var(--c-text-mute); font-size: 0.98rem; }

  .founder p { max-width: 62ch; }
  .founder-close { color: var(--c-text); font-weight: 600; }

  .service-card { display: flex; flex-direction: column; gap: 12px; }
  .service-card p { margin: 0; font-size: 0.95rem; }
  .service-card .btn { margin-top: auto; align-self: flex-start; }
  .service-card h3 { margin: 0; }
  .service-flagship { border-top: 2px solid var(--c-red); }
  .service-note { margin-top: 36px; color: var(--c-text-mute); max-width: 68ch; }
  .service-note-small { font-size: 0.9rem; color: var(--c-text-dim); margin-top: 10px; }

  .process { list-style: none; counter-reset: step; margin: 36px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .process li { counter-increment: step; }
  .process h3 { font-size: 1.02rem; display: flex; flex-direction: column; gap: 2px; }
  .process h3::before { content: counter(step, decimal-leading-zero); font-family: var(--font-mono); color: var(--c-red); font-size: 0.85rem; }
  .step-time { font-family: var(--font-mono); color: var(--c-text-dim); font-size: 0.75rem; font-weight: 400; }
  .process p { font-size: 0.92rem; color: var(--c-text-mute); }
  .process-notes { margin-top: 40px; display: grid; gap: 14px; max-width: 76ch; }
  .process-notes strong { color: var(--c-text); }

  .industry-grid { margin-top: 36px; }
  .industry-card { text-decoration: none; transition: border-color 0.18s ease; }
  .industry-card:hover { border-color: var(--c-border-strong); }
  .industry-card h3 { font-size: 1.1rem; }
  .industry-card p { color: var(--c-text-mute); font-size: 0.93rem; margin: 0; }

  .templates-sub { color: var(--c-text-mute); max-width: 66ch; margin-bottom: 36px; }
  .teaser-card { display: flex; flex-direction: column; gap: 12px; }
  .teaser-card h3 { font-size: 1.08rem; margin: 0; }
  .teaser-card h3 a { text-decoration: none; }
  .teaser-card p { margin: 0; font-size: 0.93rem; }
  .teaser-tools { font-family: var(--font-mono); font-size: 0.75rem; color: var(--c-text-dim); }
  .teaser-card .btn { margin-top: auto; align-self: flex-start; font-size: 0.88rem; padding: 10px 18px; }
  .lead-magnet { margin-top: 28px; display: flex; align-items: center; gap: 28px; justify-content: space-between; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); padding: 26px 28px; flex-wrap: wrap; }
  .lead-magnet h3 { font-size: 1.05rem; margin: 0 0 8px; }
  .lead-magnet p { margin: 0; font-size: 0.93rem; color: var(--c-text-mute); max-width: 60ch; }
  .free { color: var(--c-red); font-family: var(--font-mono); }
  .templates-all { margin-top: 26px; }

  .big-quote { margin: 0 auto; max-width: 820px; }
  .big-quote p { font-size: clamp(1.25rem, 2.6vw, 1.7rem); font-style: italic; color: var(--c-text); line-height: 1.55; max-width: none; }
  .quote-context { margin: 22px auto 0; max-width: 820px; color: var(--c-text-dim); font-size: 0.9rem; }

  .final-cta h2 { max-width: 18ch; }
  .final-cta p { max-width: 60ch; }
  .cta-alt { margin-top: 22px; color: var(--c-text-dim); font-size: 0.92rem; line-height: 2; }

  @media (max-width: 900px) {
    .proof-grid { grid-template-columns: 1fr 1fr; }
    .process { grid-template-columns: 1fr; }
  }
</style>
