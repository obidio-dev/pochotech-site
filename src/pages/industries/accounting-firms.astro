---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import CtaSection from '../../components/CtaSection.astro';
import { CALENDLY, EMAIL } from '../../data/site';
import { graph, serviceSchema, breadcrumbs, faqSchema } from '../../lib/schema';

const DESCRIPTION =
  'Bookkeeping and tax workflow automation for CPA firms — QuickBooks Online, TaxDome, quarterly tax letters, and the client communications around deadlines.';

const faqs = [
  {
    q: "Whether I've automated a CPA firm before",
    a: "Not one I can name on this page yet, and the page doesn't pretend otherwise. The component systems — QuickBooks automation, AI drafting with review steps, deadline-driven communications — each run in production for the named clients on this site.",
  },
  {
    q: 'How client financial data is handled',
    a: 'Everything runs in your accounts under your credentials, and the data stays in your systems. I work under whatever access you grant, and you can revoke it at any time.',
  },
  {
    q: 'Whether AI sends anything to clients unreviewed',
    a: 'Only if you decide it should. Default builds queue every AI-drafted letter and email for a reviewer — automation removes the assembly work, and the review step stays.',
  },
  {
    q: 'Where to start',
    a: 'The $500 audit fits firms well: a 60-minute review of one workflow — quarterly letters are a common pick — then a written report within five business days. Credited in full toward a build.',
  },
];

const jsonLd = graph(
  serviceSchema({
    name: 'AI Automation for Accounting & CPA Firms',
    description: DESCRIPTION,
    path: '/industries/accounting-firms',
  }),
  breadcrumbs([
    { name: 'Industries', path: '/industries' },
    { name: 'Accounting & CPA firms', path: '/industries/accounting-firms' },
  ]),
  faqSchema(faqs)
);
---
<Base
  title="AI Automation for Accounting & CPA Firms | pocho.tech"
  description={DESCRIPTION}
  path="/industries/accounting-firms"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <h1>Quarterly tax letters, assembled by automation, reviewed by your firm.</h1>
      <p class="hero-sub">
        I build automations for accounting and CPA firms — bookkeeping workflows in QuickBooks Online, practice
        workflows in TaxDome, quarterly tax letters, and the client communications around every deadline. This
        page describes what I build for firms; the production numbers elsewhere on this site come from the three
        named clients I've already automated.
      </p>
      <div class="hero-ctas">
        <a href={CALENDLY} class="btn btn-primary" rel="noopener">Book a discovery call</a>
      </div>
    </div>
  </section>

  <!-- Where the hours go -->
  <section class="section section-alt hours" aria-labelledby="hours-h">
    <div class="wrap">
      <h2 id="hours-h">Where the hours go</h2>
      <p>
        Every quarter, someone assembles tax letters client by client — pulling the numbers, fitting them into
        the firm's format, checking names against the file. The work is identical across clients, and it still
        gets done one at a time.
      </p>
      <p>
        Before every deadline, someone chases documents: the same reminder, personalized by hand, sent to each
        client who hasn't uploaded. Status questions arrive all week, and each one means opening TaxDome to look.
      </p>
    </div>
  </section>

  <!-- What I build -->
  <section class="section" aria-labelledby="build-h">
    <div class="wrap">
      <h2 id="build-h">What I build for accounting firms</h2>
      <div class="grid-2 systems-grid">
        <article class="card system-card">
          <h3>Quarterly tax-letter workflow</h3>
          <p>
            An automation that assembles each client's quarterly letter — data pulled from your books, the letter
            drafted by AI in your format, queued for a reviewer before anything goes out. The reviewer approves
            or edits; the system sends and logs.
          </p>
          <ul class="tools" aria-label="Tools">
            <li>QuickBooks Online</li>
            <li>TaxDome</li>
            <li>OpenAI or Anthropic</li>
            <li>Gmail</li>
          </ul>
        </article>
        <article class="card system-card">
          <h3>Document chasing and deadline communications</h3>
          <p>
            An automation that watches which clients haven't submitted, drafts each reminder from that client's
            actual status, and escalates as the deadline approaches. Nothing sends without the review step your
            firm sets.
          </p>
          <ul class="tools" aria-label="Tools">
            <li>TaxDome</li>
            <li>Gmail</li>
            <li>OpenAI</li>
          </ul>
        </article>
        <article class="card system-card">
          <h3>Bookkeeping workflows in QuickBooks Online</h3>
          <p>
            Automations that create customers and invoices, move data between systems, and keep the books in sync
            with the tools around them. QuickBooks invoice creation already runs in my production work — the
            Dahlia+ Agency pipeline creates the customer and two invoices the moment a proposal is accepted.
          </p>
          <ul class="tools" aria-label="Tools">
            <li>QuickBooks Online</li>
            <li>plus whatever feeds it</li>
          </ul>
        </article>
        <article class="card system-card">
          <h3>Client intake and status</h3>
          <p>
            Intake that creates the client record everywhere it needs to exist, and status updates drafted
            automatically when work moves stages. The inbox stops being the status system.
          </p>
          <ul class="tools" aria-label="Tools">
            <li>TaxDome</li>
            <li>Gmail</li>
            <li>your CRM</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Where the proof comes from -->
  <section class="section section-alt proof" aria-labelledby="proof-h">
    <div class="wrap">
      <h2 id="proof-h">Where the proof comes from</h2>
      <p>
        No accounting firm is named on this page yet — when one is, the numbers will be here. The component
        systems are in production elsewhere.
      </p>
      <ul class="proof-list">
        <li>
          QuickBooks automation runs daily at Dahlia+ Agency: proposal acceptance to customer plus two invoices,
          untouched.
        </li>
        <li>
          AI drafting with human review runs at TPS Workforce Hub: structured AI evaluations delivered to human
          reviewers, plus automated daily reporting.
        </li>
        <li>Twelve automations in production across three teams, spanning more than twenty tools.</li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <Faq faqs={faqs} heading="Questions firms ask" />

  <!-- CTA -->
  <CtaSection
    heading="Tell me where the quarter's hours go."
    body="Sixty minutes: you walk me through one deadline cycle, and I tell you what I'd automate first and what it would cost."
    secondaryLabel={`Or write to me directly: ${EMAIL}`}
    secondaryHref={`mailto:${EMAIL}`}
  />
</Base>

<style>
  .hero { padding: clamp(72px, 12vw, 130px) 0 56px; }
  .hero h1 { max-width: 24ch; }
  .hero-sub { font-size: 1.12rem; color: var(--c-text-body); max-width: 58ch; margin-top: 20px; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 32px; }

  .hours p { max-width: 62ch; }

  .systems-grid { margin-top: 36px; }
  .system-card { display: flex; flex-direction: column; gap: 12px; }
  .system-card h3 { margin: 0; font-size: 1.15rem; }
  .system-card p { margin: 0; font-size: 0.95rem; }
  .tools { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: auto 0 0; padding: 0; }
  .tools li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--c-text-mute);
    border: 1px solid var(--c-border);
    border-radius: 999px;
    padding: 4px 11px;
    background: var(--c-bg);
  }

  .proof p { max-width: 62ch; }
  .proof-list { margin: 24px 0 0; padding-left: 20px; max-width: 70ch; }
  .proof-list li { margin-bottom: 12px; color: var(--c-text-body); }
</style>
