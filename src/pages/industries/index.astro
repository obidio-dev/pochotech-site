---
import Base from '../../layouts/Base.astro';
import CtaSection from '../../components/CtaSection.astro';
import { EMAIL } from '../../data/site';
import { graph, breadcrumbs } from '../../lib/schema';

const jsonLd = graph(
  breadcrumbs([{ name: 'Industries', path: '/industries' }])
);
---
<Base
  title="AI Automation by Industry | pocho.tech"
  description="I go deep in four industries instead of listing forty — media, agencies, destination marketing, and accounting. Twelve automations in production."
  path="/industries"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <h1>I go deep in a few industries instead of listing forty.</h1>
      <p class="hero-sub">
        Two of them come with full case studies and real numbers — media and agencies. The other two —
        destination marketing and accounting — are pages about capability, and they say so plainly.
      </p>
    </div>
  </section>

  <!-- The four -->
  <section class="section" aria-labelledby="four-h">
    <div class="wrap">
      <h2 id="four-h">The four</h2>
      <div class="grid-2 industry-grid">
        <article class="card industry-card">
          <h3>Media &amp; publishing</h3>
          <p>
            Four automations run Matador Network's editorial back office — newsletter curation from 400+ daily
            articles, a 70-creator tracker, affiliate reporting, and event search across 15 cities. Full case
            study, two testimonials, real numbers.
          </p>
          <a href="/industries/media-publishing" class="card-link">Media &amp; publishing <span aria-hidden="true">&rarr;</span></a>
        </article>
        <article class="card industry-card">
          <h3>Marketing &amp; event agencies</h3>
          <p>
            Dahlia+ Agency runs four: web lead routing, AI referral capture, a proposal-to-invoice pipeline that
            cut processing from 1.5–2 hours to 15 minutes, and a business card scanner that lives in Slack. Full
            case study.
          </p>
          <a href="/industries/marketing-agencies" class="card-link">Marketing &amp; event agencies <span aria-hidden="true">&rarr;</span></a>
        </article>
        <article class="card industry-card">
          <h3>Destination marketing organizations</h3>
          <p>
            For tourism boards and convention bureaus: partner tracking, AI email agents, content pipelines, and
            lead qualification. I come from the travel-media side of this industry and speak at its conferences —
            no DMO client is named on that page, and it says so.
          </p>
          <a href="/industries/destination-marketing" class="card-link">Destination marketing <span aria-hidden="true">&rarr;</span></a>
        </article>
        <article class="card industry-card">
          <h3>Accounting &amp; CPA firms</h3>
          <p>
            Bookkeeping and tax workflow automation: QuickBooks Online, TaxDome, quarterly tax letters, and the
            client communications around every deadline. A capability page — what I build for firms, with the
            proof drawn from systems already in production elsewhere.
          </p>
          <a href="/industries/accounting-firms" class="card-link">Accounting &amp; CPA firms <span aria-hidden="true">&rarr;</span></a>
        </article>
      </div>
    </div>
  </section>

  <!-- Outside the four -->
  <section class="section section-alt" aria-labelledby="outside-h">
    <div class="wrap">
      <h2 id="outside-h">Outside the four</h2>
      <p class="outside-body">
        The deepest engagement on this site fits none of these categories — TPS Workforce Hub, a clean-tech
        workforce training program in Boston, runs six of my systems. If your industry isn't listed here, the
        discovery call works the same way.
      </p>
      <blockquote class="quote">
        <p>"You have done such a great job that I can't remember how we were working before you."</p>
        <cite>— CEO, TPS Energy</cite>
      </blockquote>
    </div>
  </section>

  <!-- CTA -->
  <CtaSection
    heading="Tell me where the hours go."
    body="Sixty minutes: you walk me through how your team works, and I tell you what I'd automate first and what it would cost. If it's not a fit, you'll hear that on the call."
    secondaryLabel={`Or write to me directly: ${EMAIL}`}
    secondaryHref={`mailto:${EMAIL}`}
  />
</Base>

<style>
  .hero { padding: clamp(72px, 12vw, 130px) 0 56px; }
  .hero h1 { max-width: 22ch; }
  .hero-sub { font-size: 1.12rem; color: var(--c-text-body); max-width: 58ch; margin-top: 20px; }

  .industry-grid { margin-top: 36px; }
  .industry-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    transition: border-color 0.18s ease;
  }
  .industry-card:hover { border-color: #555; }
  .industry-card h3 { margin: 0; font-size: 1.15rem; }
  .industry-card p { margin: 0; color: var(--c-text-mute); font-size: 0.95rem; }
  .card-link {
    margin-top: auto;
    color: var(--c-text);
    font-size: 0.92rem;
    text-decoration: none;
  }
  .card-link span { color: var(--c-red); }
  /* Stretched link — the whole card is clickable */
  .card-link::after { content: ''; position: absolute; inset: 0; }

  .outside-body { max-width: 62ch; }
  .quote { margin: 36px 0 0; max-width: 760px; border-left: 2px solid var(--c-border); padding-left: 20px; }
  .quote p { font-style: italic; color: var(--c-text); font-size: 1.15rem; margin: 0; max-width: none; }
  .quote cite { display: block; margin-top: 10px; color: var(--c-text-dim); font-style: normal; font-size: 0.85rem; }
</style>
