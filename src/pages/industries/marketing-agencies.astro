---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import CtaSection from '../../components/CtaSection.astro';
import { CALENDLY } from '../../data/site';
import { graph, serviceSchema, breadcrumbs, faqSchema } from '../../lib/schema';

const SCANNER_CHECKOUT = 'https://checkout.lemonsqueezy.com/buy/1320724';

const DESCRIPTION =
  'Proposal processing at Dahlia+ Agency went from 1.5–2 hours to 15 minutes. Lead routing, referral capture, and proposal-to-invoice pipelines for agencies.';

const metrics = [
  { value: '1.5–2 hrs → 15 min', label: 'Proposal processing' },
  { value: '2–4 per day', label: 'Proposals at that pace' },
  { value: '6–8 hrs/day', label: 'Manual operations gone from every working day' },
];

const faqs = [
  {
    q: 'Whether this fits marketing and PR agencies or only event production',
    a: 'The mechanics are the same: leads arrive, proposals get accepted, invoices get created. Dahlia+ is event production; the tools and deal stages change per agency, and the discovery call settles them.',
  },
  {
    q: 'What the proposal-to-invoice pipeline needs to run',
    a: 'At Dahlia+ it connects Fresh Proposals, HubSpot, Monday.com, and QuickBooks. If your stack differs, the pipeline gets rebuilt on your tools — what matters is that each system has a workable API.',
  },
  {
    q: 'What it costs',
    a: 'Custom builds start at $1,500, fixed in writing after a discovery call. The business card scanner is $249 as a template, with Done-For-You Setup for $100 more.',
  },
  {
    q: 'What happens after handoff',
    a: 'Most clients keep me on. Dahlia+ started with one automation and now runs four, on a continuing embedded engagement scoped per engagement.',
  },
];

const jsonLd = graph(
  serviceSchema({
    name: 'AI Automation for Marketing & Event Agencies',
    description: DESCRIPTION,
    path: '/industries/marketing-agencies',
  }),
  breadcrumbs([
    { name: 'Industries', path: '/industries' },
    { name: 'Marketing & event agencies', path: '/industries/marketing-agencies' },
  ]),
  faqSchema(faqs)
);
---
<Base
  title="AI Automation for Marketing Agencies | pocho.tech"
  description={DESCRIPTION}
  path="/industries/marketing-agencies"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <h1>Dahlia+ Agency gets back six to eight hours of operations a day. Four automations do it.</h1>
      <p class="hero-sub">
        I build automations for agency operations — lead routing, referral capture, proposal-to-invoice
        pipelines, and reporting. Four of them run in production at Dahlia+ Agency, an event production and
        consulting firm of six to eight people.
      </p>
      <p class="hero-sub hero-note">Their proposal processing went from 1.5–2 hours to fifteen minutes.</p>
      <div class="hero-ctas">
        <a href={CALENDLY} class="btn btn-primary" rel="noopener">Book a discovery call</a>
        <a href={SCANNER_CHECKOUT} class="btn btn-secondary" rel="noopener">Get the Business Card Scanner — $249</a>
      </div>
    </div>
  </section>

  <!-- Where the hours go -->
  <section class="section section-alt hours" aria-labelledby="hours-h">
    <div class="wrap">
      <h2 id="hours-h">Where the hours go</h2>
      <p>
        At a small agency, new business arrives from everywhere — web forms, referral emails, business cards
        collected at events — and someone retypes each one into the CRM. The ones that don't get retyped don't
        get followed up.
      </p>
      <p>
        An accepted proposal kicks off an hour and a half of administration: update the deal stage, build the
        project board, create the customer in QuickBooks, draft the invoices. At Dahlia+ Agency's pace of two to
        four proposals a day, that was six to eight hours of manual operations every working day.
      </p>
    </div>
  </section>

  <!-- What I build -->
  <section class="section" aria-labelledby="build-h">
    <div class="wrap">
      <h2 id="build-h">What I build — the four automations at Dahlia+ Agency</h2>
      <div class="grid-2 systems-grid">
        <article class="card system-card">
          <h3>Proposal-to-invoice pipeline</h3>
          <p>
            When a proposal is accepted in Fresh Proposals, the automation updates the HubSpot deal stage, builds
            the Monday.com board, and creates the QuickBooks customer with two invoices on a 50/50 split —
            untouched. Processing went from 1.5–2 hours per proposal to fifteen minutes.
          </p>
          <ul class="tools" aria-label="Tools">
            <li>Fresh Proposals</li>
            <li>HubSpot</li>
            <li>Monday.com</li>
            <li>QuickBooks</li>
          </ul>
        </article>
        <article class="card system-card">
          <h3>Web form lead routing</h3>
          <p>
            A form submission becomes a HubSpot contact, joins the Beehiiv list, and posts an alert in Slack.
            Every lead lands in the same place, logged the moment it arrives.
          </p>
          <ul class="tools" aria-label="Tools">
            <li>HubSpot</li>
            <li>Beehiiv</li>
            <li>Slack</li>
          </ul>
        </article>
        <article class="card system-card">
          <h3>AI referral capture</h3>
          <p>
            An AI parses referral emails as they arrive and creates the HubSpot record — introductions get logged
            the day they happen. The follow-up starts from the CRM instead of from memory.
          </p>
          <ul class="tools" aria-label="Tools">
            <li>Gmail</li>
            <li>OpenAI</li>
            <li>HubSpot</li>
          </ul>
        </article>
        <article class="card system-card">
          <h3>Business card scanner</h3>
          <p>
            Drop a photo in Slack; an AI reads the card, extracts every field, and creates the HubSpot contact.
            The same workflow running at Dahlia+ is in the template catalog for $249.
          </p>
          <ul class="tools" aria-label="Tools">
            <li>Slack</li>
            <li>OpenAI GPT-4o Vision</li>
            <li>HubSpot</li>
          </ul>
        </article>
      </div>
      <div class="capability">
        <h3>Reporting</h3>
        <p>
          Client and performance reporting is the same kind of build. At Matador Network, a Monday report ranks
          the top twenty affiliate links from GA4 with AI commentary — the agency version reports on your
          clients' numbers instead of your own.
        </p>
      </div>
    </div>
  </section>

  <!-- The numbers -->
  <section class="section section-alt" aria-labelledby="numbers-h">
    <div class="wrap">
      <h2 id="numbers-h">The numbers</h2>
      <dl class="metrics">
        {metrics.map((m) => (
          <div class="metric-item">
            <dt class="metric">{m.value}</dt>
            <dd>{m.label}</dd>
          </div>
        ))}
      </dl>
      <p class="context-line">
        There is no written testimonial from Dahlia+ on this page, because they haven't given one. What they do
        instead is refer new business.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <Faq faqs={faqs} heading="Questions agencies ask" />

  <!-- CTA -->
  <CtaSection
    heading="Tell me where your operations hours go."
    body="Sixty minutes: walk me through what happens between a signed proposal and a sent invoice, and I tell you what I'd automate first and what it would cost."
    secondaryLabel="Get the Business Card Scanner — $249"
    secondaryHref={SCANNER_CHECKOUT}
  />
</Base>

<style>
  .hero { padding: clamp(72px, 12vw, 130px) 0 56px; }
  .hero h1 { max-width: 24ch; }
  .hero-sub { font-size: 1.12rem; color: var(--c-text-body); max-width: 58ch; margin-top: 20px; }
  .hero-note { color: var(--c-text); font-weight: 600; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 32px; }

  .hours p { max-width: 62ch; }

  .systems-grid { margin-top: 36px; }
  .system-card { display: flex; flex-direction: column; gap: 12px; }
  .system-card h3 { margin: 0; font-size: 1.15rem; }
  .system-card p { margin: 0; font-size: 0.95rem; }
  .tools { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: auto 0 0; padding: 0; }
  .tools li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--c-text-mute);
    border: 1px solid var(--c-border);
    border-radius: 999px;
    padding: 4px 11px;
    background: var(--c-bg);
  }

  .capability {
    margin-top: 22px;
    border: 1px solid var(--c-border);
    border-left: 2px solid var(--c-red);
    border-radius: var(--radius);
    padding: 24px 28px;
  }
  .capability h3 { margin: 0 0 8px; font-size: 1.05rem; }
  .capability p { margin: 0; font-size: 0.95rem; color: var(--c-text-mute); max-width: 75ch; }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin: 36px 0 0;
  }
  .metric {
    font-family: var(--font-mono);
    color: var(--c-red);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }
  .metric-item dd { margin: 10px 0 0; color: var(--c-text-mute); font-size: 0.92rem; }

  .context-line { margin: 40px 0 0; color: var(--c-text-dim); font-size: 0.9rem; max-width: 62ch; }

  @media (max-width: 900px) {
    .metrics { grid-template-columns: 1fr; }
  }
</style>
