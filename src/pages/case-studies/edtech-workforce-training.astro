---
import Base from '../../layouts/Base.astro';
import CtaSection from '../../components/CtaSection.astro';
import { graph, breadcrumbs, reviewSchema } from '../../lib/schema';
import { EMAIL, BOILERPLATE } from '../../data/site';

const jsonLd = graph(
  breadcrumbs([
    { name: 'Inicio', path: '/' },
    { name: 'Casos', path: '/case-studies' },
    { name: 'Formación laboral EdTech', path: '/case-studies/edtech-workforce-training' },
  ]),
  reviewSchema({
    body: 'Han hecho un trabajo tan bueno que ya no me acuerdo de cómo trabajábamos antes de ustedes.',
    authorName: 'CEO',
    authorTitle: 'Empresa de formación laboral EdTech',
  })
);

const metrics = [
  { value: 'Cero → diario', label: 'De cero visibilidad operativa a reportes diarios totalmente automáticos.' },
  { value: '30–40 → 12–16', label: 'De postulantes a aceptados, con cada etapa seguida.' },
  { value: 'Domingo, cada semana', label: 'Alertas de estipendio en riesgo al participante y a su coach, antes de que el problema caiga.' },
];

const stack = [
  'Airtable',
  'OpenAI',
  'Read.ai',
  'Supabase',
  'SendGrid',
  'Microsoft Power Automate',
  'SharePoint',
  'Gmail',
];
---
<Base
  title="Formación laboral EdTech: seis sistemas conectados | pocho.tech"
  description="Seis sistemas conectados corren las admisiones y la operación de una empresa de formación laboral EdTech: entrevistas calificadas por IA, alertas de estipendio y reportes diarios. Construidos por Erick Bonilla."
  path="/case-studies/edtech-workforce-training"
  jsonLd={jsonLd}
>
  <section class="cs-header">
    <div class="wrap">
      <h1>Formación laboral EdTech</h1>
      <p class="client-line"><strong>Formación laboral en tecnología limpia, Boston.</strong> Corre un programa de capacitación de 8 semanas con estipendio para inmigrantes y minorías. De 30 a 40 postulantes por cohorte; de 12 a 16 aceptados. Seis sistemas en producción, construidos como un miembro más del equipo.</p>
    </div>
  </section>

  <section class="cs-block">
    <div class="wrap">
      <h2>El antes</h2>
      <div class="before-block">
        <p>Cada cohorte arranca con 30 a 40 postulaciones y termina con 12 a 16 cupos. Entre esos dos números: formularios de ingreso, entrevistas, calificación, correos de agenda, reglas de estipendio, y un equipo sosteniendo todo a mano.</p>
        <p>No había visibilidad operativa. Nadie podía ver, en un solo lugar, en qué punto estaba un candidato, qué entrevistas ya se habían evaluado, ni quién estaba en riesgo de perder la elegibilidad del estipendio.</p>
        <p>La parte del estipendio era la que más pesaba. Los datos de elegibilidad vivían en SharePoint, invisibles para el participante y el coach que necesitaban el aviso.</p>
      </div>
    </div>
  </section>

  <section class="cs-block">
    <div class="wrap">
      <h2>Qué construí</h2>
      <p>Seis sistemas conectados, funcionando como una sola operación.</p>
      <ol class="systems">
        <li><strong>Sistema de postulaciones en Airtable</strong>: los formularios de ingreso alimentan un solo circuito de candidatos, así cada uno tiene un único registro y una etapa visible desde la postulación hasta la aceptación.</li>
        <li><strong>Evaluación de entrevistas con IA</strong>: un webhook con la transcripción de Read.ai empareja al candidato, aplica una calificación objetiva, corre una evaluación cualitativa con IA usando citas directas de la entrevista, y entrega un resumen estructurado a los revisores humanos.</li>
        <li><strong>Agenda de entrevistas</strong>: los correos de agenda salen solos a medida que los candidatos avanzan por el circuito.</li>
        <li><strong>Reportes diarios y ejecutivos</strong>: un reporte a las 5 de la tarde para el equipo todos los días, y un resumen ejecutivo los lunes para el CEO: movimiento contra la semana anterior, datos demográficos y alertas de cuellos de botella.</li>
        <li><strong>Avisos de elegibilidad del estipendio</strong>: los datos de SharePoint pasan por Power Automate a Supabase; cada domingo, los participantes en riesgo y su coach reciben una alerta.</li>
        <li><strong>Tableros en tiempo real</strong>: vistas en vivo del circuito y de la operación del programa.</li>
      </ol>
      <p class="systems-note">La IA no decide quién entra. Lee, califica y prepara el resumen. La decisión la toman los revisores humanos.</p>
    </div>
  </section>

  <section class="section-alt numbers">
    <div class="wrap">
      <h2>Los números</h2>
      <div class="metric-grid">
        {metrics.map((m) => (
          <div class="metric-item">
            <span class="metric">{m.value}</span>
            <span class="metric-label">{m.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cs-block">
    <div class="wrap">
      <h2>Qué dice el CEO</h2>
      <blockquote>
        <p>"Han hecho un trabajo tan bueno que ya no me acuerdo de cómo trabajábamos antes de ustedes."</p>
        <cite>CEO, empresa de formación laboral EdTech</cite>
      </blockquote>
    </div>
  </section>

  <section class="cs-block">
    <div class="wrap">
      <h2>Las herramientas</h2>
      <ul class="stack-row">
        {stack.map((tool) => <li class="pill">{tool}</li>)}
      </ul>
    </div>
  </section>

  <section class="cs-block">
    <div class="wrap">
      <aside class="how-started">
        <h2>Cómo empezó</h2>
        <p>Un solo desarrollo, y después trabajo metido adentro del equipo. Un sistema se volvió seis a medida que fue apareciendo cada cuello de botella.</p>
      </aside>
    </div>
  </section>

  <CtaSection
    heading="Si su programa corre sobre formularios, entrevistas y fechas límite"
    body="Sesenta minutos: usted me explica cómo se mueven los postulantes o los clientes por su operación, y yo le digo qué automatizaría primero y cuánto costaría."
    secondaryLabel={EMAIL}
    secondaryHref={`mailto:${EMAIL}`}
  />

  <div class="wrap">
    <p class="boilerplate">{BOILERPLATE}</p>
  </div>
</Base>

<style>
  .cs-header { padding-block: var(--space-section) clamp(36px, 5vw, 56px); }
  .client-line { color: var(--c-text-mute); max-width: 70ch; margin-top: 16px; }
  .client-line strong { color: var(--c-text); }

  .cs-block { padding-block: clamp(40px, 6vw, 64px); }

  .before-block {
    border-left: 2px solid var(--c-border);
    padding-left: clamp(20px, 3vw, 32px);
    margin-left: 8px;
    max-width: 70ch;
  }
  .before-block p:last-child { margin-bottom: 0; }

  .systems {
    list-style: none;
    counter-reset: sys;
    margin: 28px 0 0;
    padding: 0;
    max-width: 72ch;
  }
  .systems li {
    counter-increment: sys;
    position: relative;
    padding-left: 56px;
    margin-bottom: 24px;
  }
  .systems li:last-child { margin-bottom: 0; }
  .systems li::before {
    content: counter(sys, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 3px;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--c-text-dim);
  }
  .systems strong { color: var(--c-text); }
  .systems-note {
    margin-top: 28px;
    color: var(--c-text-mute);
    max-width: 70ch;
  }

  .numbers { padding-block: var(--space-section); }
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 40px 36px;
    margin-top: 40px;
  }
  .metric {
    display: block;
    font-family: var(--font-mono);
    color: var(--c-red);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .metric-label {
    display: block;
    margin-top: 12px;
    color: var(--c-text-mute);
    font-size: 0.95rem;
    max-width: 36ch;
  }

  blockquote {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 28px 32px;
    margin: 24px 0 0;
    max-width: 70ch;
  }
  blockquote p {
    font-size: 1.15rem;
    color: var(--c-text);
    margin: 0 0 14px;
  }
  blockquote cite {
    display: block;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--c-text-mute);
  }

  .stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .pill {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--c-text-mute);
    border: 1px solid var(--c-border);
    border-radius: 999px;
    padding: 7px 16px;
  }

  .how-started h2 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-text-dim);
    margin-bottom: 12px;
  }
  .how-started p {
    color: var(--c-text-mute);
    font-size: 0.95rem;
    margin: 0;
    max-width: 60ch;
  }

  .boilerplate {
    color: var(--c-text-dim);
    font-size: 0.88rem;
    font-style: italic;
    margin: 40px 0 0;
    max-width: 75ch;
  }
</style>
