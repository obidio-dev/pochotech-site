---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { Image } from 'astro:assets';
import shot from '../../assets/workflows/AINewsletterCurator.PNG';
import { templates } from '../../data/templates';
import { graph, productSchema, breadcrumbs, faqSchema } from '../../lib/schema';

const t = templates.find((x) => x.slug === 'ai-newsletter-curator')!;

const faqs = [
  {
    q: 'Setup time',
    a: 'Plan for about 30 minutes: import the JSON, connect Google Sheets, Apify, OpenAI, and Gmail, then add your first sources to the Sheet. The first newsletter arrives the next morning.',
  },
  {
    q: 'What you need',
    a: 'A running n8n instance — n8n Cloud or self-hosted both work — plus a Google account, an Apify account, and an OpenAI API key.',
  },
  {
    q: 'Customization',
    a: 'Your sources live in the Google Sheet, so changing coverage is editing a row. The selection criteria, story count, and tone are all in the prompt, open to edit.',
  },
];

const jsonLd = graph(
  productSchema({
    name: 'AI Newsletter Curator',
    description:
      'The AI Newsletter Curator is an n8n workflow with an AI that scrapes your chosen industry sources overnight, picks the most newsworthy stories, writes summaries, and delivers a finished newsletter every morning.',
    path: '/templates/ai-newsletter-curator',
    price: t.price,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Templates', path: '/templates' },
    { name: 'AI Newsletter Curator', path: '/templates/ai-newsletter-curator' },
  ]),
  faqSchema(faqs)
);
---
<Base
  title="AI Newsletter Curator — n8n Template | pocho.tech"
  description="An AI that scrapes your sources overnight, picks the top stories, and delivers a finished newsletter each morning. 400+ articles/day at Matador Network."
  path="/templates/ai-newsletter-curator"
  jsonLd={jsonLd}
>
  <article>
    <header class="tpl-top">
      <div class="wrap tpl-wrap">
        <h1>AI Newsletter Curator</h1>
        <figure class="workflow-shot">
          <Image src={shot} alt={t.imageAlt} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 800px" loading="eager" />
          <figcaption>Workflow built in n8n</figcaption>
        </figure>
        <p class="opener">
          The AI Newsletter Curator is an n8n workflow with an AI that scrapes your chosen industry sources
          overnight, picks the most newsworthy stories, writes summaries, and delivers a finished newsletter
          every morning.
        </p>
        <p class="opener">
          The production version runs at Matador Network, where it processes 400+ articles a day from eleven-plus
          publications with zero human input. $249, one-time.
        </p>
      </div>
    </header>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="does-h">
      <h2 id="does-h">What it does</h2>
      <ul>
        <li>You list your sources in a Google Sheet — publications, blogs, anything Apify can scrape</li>
        <li>Apify collects every new article overnight</li>
        <li>An AI reads the full set, picks the most newsworthy stories, and writes a summary of each</li>
        <li>A finished newsletter arrives in your inbox every morning, ready to send or publish</li>
      </ul>
    </section>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="incl-h">
      <h2 id="incl-h">What's included</h2>
      <ul>
        <li>The complete n8n workflow JSON, ready to import</li>
        <li>A step-by-step PDF setup guide</li>
        <li>A 90-second walkthrough video of the working system</li>
      </ul>
    </section>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="integ-h">
      <h2 id="integ-h">Integrations</h2>
      <p class="integrations-line">Google Sheets, Apify, OpenAI, Gmail.</p>
    </section>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="price-h">
      <h2 id="price-h">Price</h2>
      <p class="price-line"><span class="price-big">$249</span> — one-time purchase.</p>
      <a href={t.checkout} class="btn btn-primary" rel="noopener">Get the AI Newsletter Curator — $249</a>
      <p class="upsell">
        Add Done-For-You Setup for $100 and I install it with you on a live 60–90 minute call — credentials
        connected, workflow configured, tested live, recording included.
      </p>
    </section>

    <Faq faqs={faqs} heading="Questions before you buy" />

    <div class="wrap tpl-wrap">
      <a href="/templates">Back to all templates →</a>
    </div>
  </article>
</Base>

<style>
  .tpl-top { padding: clamp(64px, 10vw, 110px) 0 0; }
  .tpl-wrap { max-width: 800px; }
  .workflow-shot { margin: 36px 0 40px; }
  .workflow-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }
  .workflow-shot figcaption {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--c-text-mute);
  }
  .opener { font-size: 1.08rem; max-width: 62ch; }
  .tpl-section { margin-top: clamp(48px, 7vw, 72px); }
  .tpl-section ul { margin: 18px 0 0; padding-left: 22px; display: grid; gap: 10px; max-width: 65ch; }
  .integrations-line { font-family: var(--font-mono); font-size: 0.92rem; color: var(--c-text-mute); }
  .price-line { margin: 10px 0 26px; }
  .price-big {
    font-family: var(--font-mono);
    color: var(--c-red);
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
    font-weight: 700;
  }
  .upsell { margin-top: 24px; color: var(--c-text-mute); font-size: 0.95rem; }
</style>
