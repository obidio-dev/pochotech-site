---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { Image } from 'astro:assets';
import shot from '../../assets/workflows/Sheets_Hubspot_Task_Manager.PNG';
import { templates } from '../../data/templates';
import { graph, productSchema, breadcrumbs, faqSchema } from '../../lib/schema';

const t = templates.find((x) => x.slug === 'sheets-hubspot-task-manager')!;

const faqs = [
  {
    q: 'Setup time',
    a: 'This is the shortest setup in the catalog: two credentials and one sheet. Plan for 15 minutes with the PDF guide open.',
  },
  {
    q: 'What you need',
    a: 'A running n8n instance, n8n Cloud or self-hosted both work, plus a Google account and a HubSpot account.',
  },
  {
    q: 'Customization',
    a: 'Every node is open and editable: map extra columns, rename fields, or change the sync interval. If this sync is useful, the paid templates and custom builds are the same kind of work at larger scale.',
  },
];

const jsonLd = graph(
  productSchema({
    name: 'Sheets ↔ HubSpot Task Manager',
    description:
      'The Sheets ↔ HubSpot Task Manager is a free n8n workflow: a live two-way sync between a Google Sheet and HubSpot tasks: create, update, and complete in either, and both stay current.',
    path: '/templates/sheets-hubspot-task-manager',
    price: t.price,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Templates', path: '/templates' },
    { name: 'Sheets ↔ HubSpot Task Manager', path: '/templates/sheets-hubspot-task-manager' },
  ]),
  faqSchema(faqs)
);
---
<Base
  title="Sheets ↔ HubSpot Task Manager: Free Template | pocho.tech"
  description="A free n8n template: live two-way sync between Google Sheets and HubSpot tasks. Create, update, and complete in either; both stay current."
  path="/templates/sheets-hubspot-task-manager"
  jsonLd={jsonLd}
>
  <article>
    <header class="tpl-top">
      <div class="wrap tpl-wrap">
        <h1>Sheets ↔ HubSpot Task Manager</h1>
        <figure class="workflow-shot">
          <Image src={shot} alt={t.imageAlt} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 800px" loading="eager" />
          <figcaption>Workflow built in n8n</figcaption>
        </figure>
        <p class="opener">
          The Sheets ↔ HubSpot Task Manager is a free n8n workflow: a live two-way sync between a Google Sheet
          and HubSpot tasks: create, update, and complete in either, and both stay current.
        </p>
        <p class="opener">
          It's the no-cost way to see how I build before spending anything. Checkout asks for your email, and the
          files arrive there.
        </p>
      </div>
    </header>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="does-h">
      <h2 id="does-h">What it does</h2>
      <ul>
        <li>Add a task row in the Google Sheet and the task appears in HubSpot</li>
        <li>Create or change a task in HubSpot and the Sheet updates to match</li>
        <li>Complete a task on either side and both reflect it</li>
        <li>The sync runs continuously in your own n8n instance</li>
      </ul>
    </section>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="incl-h">
      <h2 id="incl-h">What's included</h2>
      <ul>
        <li>The complete n8n workflow JSON, ready to import</li>
        <li>A step-by-step PDF setup guide</li>
        <li>A 90-second walkthrough video of the working system</li>
      </ul>
    </section>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="integ-h">
      <h2 id="integ-h">Integrations</h2>
      <p class="integrations-line">Google Sheets, HubSpot.</p>
    </section>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="price-h">
      <h2 id="price-h">Price</h2>
      <p class="price-line"><span class="price-big">Free.</span></p>
      <a href={t.checkout} class="btn btn-primary" rel="noopener">Get it free</a>
      <p class="upsell">
        Done-For-You Setup is available here too: $100 for a live 60–90 minute call where I connect, configure,
        and test it with you, recording included.
      </p>
    </section>

    <Faq faqs={faqs} heading="Questions before you buy" />

    <div class="wrap tpl-wrap">
      <a href="/templates">Back to all templates →</a>
    </div>
  </article>
</Base>

<style>
  .tpl-top { padding: clamp(64px, 10vw, 110px) 0 0; }
  .tpl-wrap { max-width: 800px; }
  .workflow-shot { margin: 36px 0 40px; }
  .workflow-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }
  .workflow-shot figcaption {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--c-text-mute);
  }
  .opener { font-size: 1.08rem; max-width: 62ch; }
  .tpl-section { margin-top: clamp(48px, 7vw, 72px); }
  .tpl-section ul { margin: 18px 0 0; padding-left: 22px; display: grid; gap: 10px; max-width: 65ch; }
  .integrations-line { font-family: var(--font-mono); font-size: 0.92rem; color: var(--c-text-mute); }
  .price-line { margin: 10px 0 26px; }
  .price-big {
    font-family: var(--font-mono);
    color: var(--c-red);
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
    font-weight: 700;
  }
  .upsell { margin-top: 24px; color: var(--c-text-mute); font-size: 0.95rem; }
</style>
