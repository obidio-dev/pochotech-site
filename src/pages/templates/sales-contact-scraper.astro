---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { Image } from 'astro:assets';
import shot from '../../assets/workflows/SalesContactScraper.PNG';
import { templates } from '../../data/templates';
import { graph, productSchema, breadcrumbs, faqSchema } from '../../lib/schema';

const t = templates.find((x) => x.slug === 'sales-contact-scraper')!;

const faqs = [
  {
    q: 'Setup time',
    a: "Plan for about 30 minutes: import the JSON, connect Gmail, Apify, and Google Sheets, then run the test steps in the PDF guide. The first full scan runs on its own once it's live.",
  },
  {
    q: 'What you need',
    a: 'A running n8n instance, n8n Cloud or self-hosted both work, plus Gmail, an Apify account, and Google Sheets.',
  },
  {
    q: 'Customization',
    a: 'Every node is open and editable: narrow the mailbox scope, add enrichment fields, or point the output at a different destination. If you want it adapted beyond that, Done-For-You Setup covers configuration and a custom build covers the rest.',
  },
];

const jsonLd = graph(
  productSchema({
    name: 'Sales Contact Scraper',
    description:
      "The Sales Contact Scraper is an n8n automation that scans your Gmail history, extracts every person you've emailed, enriches them with company information from their websites, and delivers an organized contact list.",
    path: '/templates/sales-contact-scraper',
    price: t.price,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Templates', path: '/templates' },
    { name: 'Sales Contact Scraper', path: '/templates/sales-contact-scraper' },
  ]),
  faqSchema(faqs)
);
---
<Base
  title="Sales Contact Scraper: n8n Template | pocho.tech"
  description="An automation that scans your Gmail history, extracts everyone you've emailed, enriches them with company info, and delivers a clean contact list. $299."
  path="/templates/sales-contact-scraper"
  jsonLd={jsonLd}
>
  <article>
    <header class="tpl-top">
      <div class="wrap tpl-wrap">
        <h1>Sales Contact Scraper</h1>
        <figure class="workflow-shot">
          <Image src={shot} alt={t.imageAlt} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 800px" loading="eager" />
          <figcaption>Workflow built in n8n</figcaption>
        </figure>
        <p class="opener">
          The Sales Contact Scraper is an n8n automation that scans your Gmail history, extracts every person
          you've emailed, enriches them with company information from their websites, and delivers an organized
          contact list.
        </p>
        <p class="opener">
          Years of correspondence become a working list in a Google Sheet. $299, one-time, extracted from real
          client systems.
        </p>
      </div>
    </header>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="does-h">
      <h2 id="does-h">What it does</h2>
      <ul>
        <li>Scans your Gmail history and extracts every person you've corresponded with</li>
        <li>Filters and organizes them into a single structured list</li>
        <li>Apify visits each contact's company website and pulls company information</li>
        <li>Delivers the enriched list to a Google Sheet</li>
      </ul>
    </section>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="incl-h">
      <h2 id="incl-h">What's included</h2>
      <ul>
        <li>The complete n8n workflow JSON, ready to import</li>
        <li>A step-by-step PDF setup guide</li>
        <li>A 90-second walkthrough video of the working system</li>
      </ul>
    </section>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="integ-h">
      <h2 id="integ-h">Integrations</h2>
      <p class="integrations-line">Gmail, Apify, Google Sheets.</p>
    </section>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="price-h">
      <h2 id="price-h">Price</h2>
      <p class="price-line"><span class="price-big">$299</span>, one-time purchase.</p>
      <a href={t.checkout} class="btn btn-primary" rel="noopener">Get the Sales Contact Scraper: $299</a>
      <p class="upsell">
        Add Done-For-You Setup for $100 and I install it with you on a live 60–90 minute call: credentials
        connected, workflow configured, tested live, recording included.
      </p>
    </section>

    <Faq faqs={faqs} heading="Questions before you buy" />

    <div class="wrap tpl-wrap">
      <a href="/templates">Back to all templates →</a>
    </div>
  </article>
</Base>

<style>
  .tpl-top { padding: clamp(64px, 10vw, 110px) 0 0; }
  .tpl-wrap { max-width: 800px; }
  .workflow-shot { margin: 36px 0 40px; }
  .workflow-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }
  .workflow-shot figcaption {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--c-text-mute);
  }
  .opener { font-size: 1.08rem; max-width: 62ch; }
  .tpl-section { margin-top: clamp(48px, 7vw, 72px); }
  .tpl-section ul { margin: 18px 0 0; padding-left: 22px; display: grid; gap: 10px; max-width: 65ch; }
  .integrations-line { font-family: var(--font-mono); font-size: 0.92rem; color: var(--c-text-mute); }
  .price-line { margin: 10px 0 26px; }
  .price-big {
    font-family: var(--font-mono);
    color: var(--c-red);
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
    font-weight: 700;
  }
  .upsell { margin-top: 24px; color: var(--c-text-mute); font-size: 0.95rem; }
</style>
