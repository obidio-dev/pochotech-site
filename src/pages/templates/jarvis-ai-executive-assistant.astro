---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { Image } from 'astro:assets';
import shot from '../../assets/workflows/Jarvis.PNG';
import { templates } from '../../data/templates';
import { graph, productSchema, breadcrumbs, faqSchema } from '../../lib/schema';

const t = templates.find((x) => x.slug === 'jarvis-ai-executive-assistant')!;

const faqs = [
  {
    q: 'Setup time',
    a: '30–45 minutes: this is the most involved setup in the catalog, with seven integrations to connect. The PDF guide goes node by node, and Done-For-You Setup exists for exactly this template.',
  },
  {
    q: 'What you need',
    a: 'A running n8n instance, n8n Cloud or self-hosted both work, plus a Slack workspace, a Google account, an Anthropic API key, and a PostgreSQL database.',
  },
  {
    q: 'Customization',
    a: 'The system prompt reference is the control surface: edit it to change what Jarvis handles, how it writes, and where it stops. Every tool it touches is a standard n8n node you can swap or extend.',
  },
];

const jsonLd = graph(
  productSchema({
    name: 'Jarvis: AI Executive Assistant',
    description:
      'Jarvis is an n8n workflow that puts an AI assistant inside Slack: it reads your email, manages your calendar, and tracks your tasks on plain-English instructions.',
    path: '/templates/jarvis-ai-executive-assistant',
    price: t.price,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Templates', path: '/templates' },
    { name: 'Jarvis: AI Executive Assistant', path: '/templates/jarvis-ai-executive-assistant' },
  ]),
  faqSchema(faqs)
);
---
<Base
  title="Jarvis: AI Executive Assistant n8n Template | pocho.tech"
  description="An AI executive assistant inside Slack: reads your email, manages your calendar, tracks tasks on plain-English instructions. n8n template, $399."
  path="/templates/jarvis-ai-executive-assistant"
  jsonLd={jsonLd}
>
  <article>
    <header class="tpl-top">
      <div class="wrap tpl-wrap">
        <h1>Jarvis: AI Executive Assistant</h1>
        <figure class="workflow-shot">
          <Image src={shot} alt={t.imageAlt} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 800px" loading="eager" />
          <figcaption>Workflow built in n8n</figcaption>
        </figure>
        <p class="opener">
          Jarvis is an n8n workflow that puts an AI assistant inside Slack: it reads your email, manages your
          calendar, and tracks your tasks on plain-English instructions.
        </p>
        <p class="opener">
          It's the most involved template in the catalog: a main workflow, a sub-workflow, and a system prompt
          reference, running on Anthropic Claude with PostgreSQL for memory. $399, one-time.
        </p>
      </div>
    </header>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="does-h">
      <h2 id="does-h">What it does</h2>
      <ul>
        <li>Takes plain-English instructions in Slack: your inbox, your day, your open tasks</li>
        <li>Reads and searches your Gmail and reports back in the conversation</li>
        <li>Creates and updates events in Google Calendar, and looks people up in Google Contacts</li>
        <li>Adds, updates, and completes items in Google Tasks</li>
        <li>Anthropic Claude does the reasoning; PostgreSQL stores conversation history so context carries over</li>
      </ul>
    </section>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="incl-h">
      <h2 id="incl-h">What's included</h2>
      <ul>
        <li>The main workflow JSON and the sub-workflow JSON, ready to import</li>
        <li>The system prompt reference document</li>
        <li>A step-by-step PDF setup guide</li>
        <li>A 90-second walkthrough video of the working system</li>
      </ul>
    </section>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="integ-h">
      <h2 id="integ-h">Integrations</h2>
      <p class="integrations-line">Slack, Gmail, Google Calendar, Google Tasks, Google Contacts, Anthropic Claude, PostgreSQL.</p>
    </section>

    <section class="wrap tpl-wrap tpl-section" aria-labelledby="price-h">
      <h2 id="price-h">Price</h2>
      <p class="price-line"><span class="price-big">$399</span>, one-time purchase.</p>
      <a href={t.checkout} class="btn btn-primary" rel="noopener">Get Jarvis: $399</a>
      <p class="upsell">
        If you'd rather not wire seven integrations yourself, add Done-For-You Setup for $100: a live 60–90
        minute call where I connect, configure, and test it with you, recording included.
      </p>
    </section>

    <Faq faqs={faqs} heading="Questions before you buy" />

    <div class="wrap tpl-wrap">
      <a href="/templates">Back to all templates →</a>
    </div>
  </article>
</Base>

<style>
  .tpl-top { padding: clamp(64px, 10vw, 110px) 0 0; }
  .tpl-wrap { max-width: 800px; }
  .workflow-shot { margin: 36px 0 40px; }
  .workflow-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }
  .workflow-shot figcaption {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--c-text-mute);
  }
  .opener { font-size: 1.08rem; max-width: 62ch; }
  .tpl-section { margin-top: clamp(48px, 7vw, 72px); }
  .tpl-section ul { margin: 18px 0 0; padding-left: 22px; display: grid; gap: 10px; max-width: 65ch; }
  .integrations-line { font-family: var(--font-mono); font-size: 0.92rem; color: var(--c-text-mute); }
  .price-line { margin: 10px 0 26px; }
  .price-big {
    font-family: var(--font-mono);
    color: var(--c-red);
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
    font-weight: 700;
  }
  .upsell { margin-top: 24px; color: var(--c-text-mute); font-size: 0.95rem; }
</style>
