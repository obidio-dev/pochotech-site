---
import Base from '../layouts/Base.astro';
---
<Base
  title="Página no encontrada | pocho.tech"
  description="Esta página no existe. El inicio y los casos sí."
  path="/404"
  noindex
>
  <section class="nf">
    <div class="wrap nf-wrap">
      <h1>Página no encontrada</h1>
      <p>Esta página no existe. Estas sí.</p>
      <ul class="nf-links">
        <li><a href="/">Inicio</a></li>
        <li><a href="/demos">Demos</a></li>
        <li><a href="/case-studies">Casos</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf { padding: clamp(100px, 18vw, 200px) 0; }
  .nf-wrap { text-align: center; }
  .nf-wrap p { margin: 0 auto; color: var(--c-text-mute); }
  .nf-links {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .nf-links a { font-size: 1.02rem; }
</style>
