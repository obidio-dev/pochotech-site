---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaSection from '../../components/CtaSection.astro';
import { graph, breadcrumbs } from '../../lib/schema';
import { EMAIL, BOILERPLATE } from '../../data/site';

// Posts with a future date stay hidden until the site is rebuilt on or after
// their publish date. Set BLOG_PREVIEW=1 to include them in a local build.
const now = new Date();
const preview = !!import.meta.env.BLOG_PREVIEW || !!process.env.BLOG_PREVIEW;
const posts = (await getCollection('blog', ({ data }) => preview || data.date <= now)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date, lang: string) =>
  d.toLocaleDateString(lang === 'es' ? 'es-NI' : 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const jsonLd = graph(
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
  ])
);
---
<Base
  title="Blog — Agents in Production, Written Down | pocho.tech"
  description="Field notes from AI automation projects in production: what gets automated, what stays human, what it costs, and what breaks. By Erick Bonilla."
  path="/blog"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Blog</p>
      <h1>Agents in production, written down.</h1>
      <p class="lead">Long-form notes from real automation projects: what gets built first, what stays with a human, what it costs, and what breaks along the way.</p>
    </div>
  </section>

  <section class="posts">
    <div class="wrap">
      {posts.length === 0 && <p class="empty">First article coming soon.</p>}
      {posts.map((post) => (
        <article class="post-item">
          <p class="post-meta">
            <time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt(post.data.date, post.data.lang)}</time>
            {post.data.lang === 'es' && <span class="lang-tag">Español</span>}
          </p>
          <h2><a href={`/blog/${post.data.slug}`}>{post.data.title}</a></h2>
          <p class="post-desc">{post.data.description}</p>
          <a class="post-link" href={`/blog/${post.data.slug}`}>Read the article →</a>
        </article>
      ))}
    </div>
  </section>

  <CtaSection
    heading="Tell me where the hours go."
    body="Sixty minutes: you walk me through how your team works, and I tell you what I'd automate first and what it would cost."
    secondaryLabel={EMAIL}
    secondaryHref={`mailto:${EMAIL}`}
  />

  <div class="wrap">
    <p class="boilerplate">{BOILERPLATE}</p>
  </div>
</Base>

<style>
  .hero { padding-block: var(--space-section) clamp(40px, 6vw, 64px); }
  .lead {
    font-size: 1.15rem;
    color: var(--c-text-mute);
    max-width: 62ch;
    margin-top: 18px;
  }
  .posts { padding-block: 0 clamp(40px, 6vw, 64px); }
  .empty { color: var(--c-text-dim); font-family: var(--font-mono); }
  .post-item {
    border-top: 1px solid var(--c-border);
    padding-block: clamp(36px, 5vw, 56px);
    max-width: 75ch;
  }
  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--c-text-dim);
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .lang-tag {
    border: 1px solid var(--c-border);
    border-radius: 4px;
    padding: 1px 8px;
    font-size: 0.75rem;
    color: var(--c-text-mute);
  }
  .post-item h2 { font-size: clamp(1.35rem, 2.6vw, 1.8rem); margin-top: 12px; }
  .post-item h2 a { color: var(--c-text); text-decoration: none; }
  .post-item h2 a:hover { color: var(--c-red); }
  .post-desc { color: var(--c-text-mute); margin-top: 12px; }
  .post-link {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }
  .boilerplate {
    color: var(--c-text-dim);
    font-size: 0.88rem;
    font-style: italic;
    margin: 40px 0 0;
    max-width: 75ch;
  }
</style>
