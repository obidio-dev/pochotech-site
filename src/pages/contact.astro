---
import Base from '../layouts/Base.astro';
import { CALENDLY, EMAIL } from '../data/site';
import { graph, breadcrumbs } from '../lib/schema';

const jsonLd = graph(
  breadcrumbs([{ name: 'Contacto', path: '/contact' }])
);
---
<Base
  title="Contacto: agende una llamada | pocho.tech"
  description="Agende una llamada de 60 minutos con Erick Bonilla, o escriba directo. En la mayoría de las llamadas sale el primer proceso que vale la pena automatizar dentro de la primera media hora."
  path="/contact"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <h1>Empecemos con una llamada</h1>
      <p class="hero-sub">
        Sesenta minutos, agendados directo en mi calendario. Usted me explica cómo trabaja su equipo, y yo busco
        dónde se van las horas.
      </p>
      <div class="hero-ctas">
        <a href={CALENDLY} class="btn btn-primary btn-lg" rel="noopener">Agendar una llamada</a>
      </div>
    </div>
  </section>

  <!-- What happens on the call -->
  <section class="section section-alt" aria-labelledby="call-h">
    <div class="wrap">
      <h2 id="call-h">Qué pasa en la llamada</h2>
      <p>
        Normalmente, dentro de los primeros quince a treinta minutos ya identificamos al menos un proceso que
        vale la pena automatizar, y le digo si necesita un desarrollo a la medida o el diagnóstico de $500
        primero. Sin presentación y sin venta: si no calza, lo escucha en la llamada.
      </p>
    </div>
  </section>

  <!-- Prefer email -->
  <section class="section" aria-labelledby="email-h">
    <div class="wrap">
      <h2 id="email-h">Si prefiere el correo</h2>
      <p>
        Escríbame directo: <a href={`mailto:${EMAIL}`}>{EMAIL}</a>. Yo leo y contesto todo. Acá no hay nadie más.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(72px, 12vw, 130px) 0 56px; }
  .hero h1 { max-width: 22ch; }
  .hero-sub { font-size: 1.12rem; color: var(--c-text-body); max-width: 58ch; margin-top: 20px; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 32px; }
  .btn-lg { padding: 16px 34px; font-size: 1.05rem; }

  .section p { max-width: 62ch; }
</style>
