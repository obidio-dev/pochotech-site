---
import Base from '../layouts/Base.astro';
import { CALENDLY, EMAIL } from '../data/site';
import { graph, breadcrumbs } from '../lib/schema';

const jsonLd = graph(
  breadcrumbs([{ name: 'Contact', path: '/contact' }])
);
---
<Base
  title="Contact: Book a Discovery Call | pocho.tech"
  description="Book a 60-minute discovery call with Erick Bonilla, or email directly. Most calls identify the first workflow worth automating within thirty minutes."
  path="/contact"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <h1>Start with a call</h1>
      <p class="hero-sub">
        Sixty minutes, booked directly on my calendar. You walk me through how your team works, and I look for
        where the hours go.
      </p>
      <div class="hero-ctas">
        <a href={CALENDLY} class="btn btn-primary btn-lg" rel="noopener">Book a discovery call</a>
      </div>
    </div>
  </section>

  <!-- What happens on the call -->
  <section class="section section-alt" aria-labelledby="call-h">
    <div class="wrap">
      <h2 id="call-h">What happens on the call</h2>
      <p>
        Usually within the first fifteen to thirty minutes, we've identified at least one workflow worth
        automating, and I'll tell you whether it needs a custom build or the $500 audit first. No deck and no
        pitch; if it's not a fit, you'll hear that on the call.
      </p>
    </div>
  </section>

  <!-- Prefer email -->
  <section class="section" aria-labelledby="email-h">
    <div class="wrap">
      <h2 id="email-h">Prefer email</h2>
      <p>
        Write to me directly: <a href={`mailto:${EMAIL}`}>{EMAIL}</a>. I read and answer everything myself.
        There's no one else here.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(72px, 12vw, 130px) 0 56px; }
  .hero h1 { max-width: 22ch; }
  .hero-sub { font-size: 1.12rem; color: var(--c-text-body); max-width: 58ch; margin-top: 20px; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 32px; }
  .btn-lg { padding: 16px 34px; font-size: 1.05rem; }

  .section p { max-width: 62ch; }
</style>
