---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import CtaSection from '../../components/CtaSection.astro';
import { graph, breadcrumbs, serviceSchema, faqSchema } from '../../lib/schema';

const title = 'Done-For-You Setup: Template + $100 | pocho.tech';
const description =
  'Add $100 to any template and I install it with you on a live 60–90 minute call: credentials connected, configured, tested live. You keep a recording.';

const faqs = [
  {
    q: 'What I need from you before the call',
    a: "Admin access to the tools the template connects: for the Business Card Scanner, that's Slack, OpenAI, and HubSpot. The exact list for your template is in its PDF guide, and I send it again when you book.",
  },
  {
    q: 'Whether you could set it up yourself instead',
    a: 'Yes, every template ships with the workflow JSON, a step-by-step PDF, and a walkthrough video, and most go live in under an hour on your own. The session is for teams that want it running today, verified live on their data, with a recording to keep.',
  },
  {
    q: "What happens if the template doesn't match your stack",
    a: "Each template works as described with the tools listed on its page. If your stack is different, another CRM, extra steps in the process, that's a custom build conversation, and you can write to me first at erick.bonilla63@gmail.com to check before buying.",
  },
];

const jsonLd = graph(
  serviceSchema({
    name: 'Done-For-You Setup',
    description,
    path: '/services/done-for-you-setup',
    price: '100',
  }),
  breadcrumbs([
    { name: 'Services', path: '/services' },
    { name: 'Done-For-You Setup', path: '/services/done-for-you-setup' },
  ]),
  faqSchema(faqs)
);
---
<Base title={title} description={description} path="/services/done-for-you-setup" jsonLd={jsonLd}>
  <section class="section hero">
    <div class="wrap">
      <h1>Done-For-You Setup</h1>
      <p>
        Done-For-You Setup adds $100 to any template in the catalog. We meet on a live 60–90 minute call: I
        connect your credentials, configure the workflow for your accounts, and test it with you watching, and
        you keep a recording of the whole session.
      </p>
      <p>You buy the workflow; I make sure it's running before we hang up.</p>
      <a href="/templates" class="btn btn-primary">Browse the templates</a>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="session-h">
    <div class="wrap">
      <h2 id="session-h">How the session works</h2>
      <div class="stages">
        <p>
          <strong>Before the call.</strong> You buy the template, add the setup option, and book a time on my
          calendar. I send a short list of the logins and access the workflow needs, so the session starts at full
          speed.
        </p>
        <p>
          <strong>On the call: 60 to 90 minutes.</strong> I connect each credential, configure the workflow for
          your accounts, and run it live until it behaves on your real data. Then I walk you through how it works
          and where to adjust it.
        </p>
        <p>
          <strong>After the call.</strong> The workflow is live in your accounts, and the recording arrives so
          anyone on your team can replay the entire setup.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="takeaway-h">
    <div class="wrap">
      <h2 id="takeaway-h">What you walk away with</h2>
      <ul class="takeaway-list">
        <li>The workflow running in your accounts, under your credentials</li>
        <li>A recording of the full session</li>
        <li>The template's step-by-step PDF guide and 90-second walkthrough video</li>
        <li>Working knowledge of where to change it when your process changes</li>
      </ul>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="covers-h">
    <div class="wrap">
      <h2 id="covers-h">Which templates this covers</h2>
      <p>
        All seven, including the free Sheets ↔ HubSpot sync. Jarvis, the AI executive assistant, is the most
        involved template in the catalog, which makes it the one where the setup session earns its $100 most
        clearly.
      </p>
      <p><a href="/templates">Browse the templates</a></p>
    </div>
  </section>

  <Faq faqs={faqs} heading="Questions before you book a session" />

  <CtaSection
    heading="Pick the workflow, and I'll handle the wiring"
    body="Every template page has the Done-For-You option at checkout. If you're not sure which one fits your team, sixty minutes on a call settles it."
    secondaryLabel="Browse the templates"
    secondaryHref="/templates"
  />
</Base>

<style>
  .hero h1 { max-width: 22ch; }
  .hero p { max-width: 62ch; }
  .hero .btn { margin-top: 18px; }

  .stages {
    margin-top: 28px;
    display: grid;
    gap: 18px;
    max-width: 70ch;
  }
  .stages p { margin: 0; }
  .stages strong { color: var(--c-text); }

  .takeaway-list {
    margin: 24px 0 0;
    padding-left: 20px;
    display: grid;
    gap: 10px;
    max-width: 70ch;
  }
</style>
